{
  "name": "emval-reglas",
  "private": true,
  "description": "Pruebas de Firebase Auth contra el emulador (reglas de la etapa 2, tools/cuentas-auth.js, tools/estado-telefonos.js). Ver README.md. No se publican (tests/ esta excluido de Pages).",
  "scripts": {
    "reglas": "firebase emulators:exec --only firestore --project demo-emval \"node reglas.test.js\"",
    "reglas-capa1": "firebase emulators:exec --only firestore --project demo-emval \"node reglas.test.js --capa1\"",
    "cuentas": "firebase emulators:exec --only auth,firestore --project demo-emval \"node cuentas-auth.test.js\"",
    "estado": "firebase emulators:exec --only firestore --project demo-emval \"node estado-telefonos.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.32.1"
  }
}
